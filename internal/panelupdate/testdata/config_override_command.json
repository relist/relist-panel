{
  "name": "su-test-fx",
  "networks": {
    "relist-network": {
      "name": "relist-network",
      "ipam": {},
      "external": true
    }
  },
  "services": {
    "panel": {
      "cpus": 0.25,
      "command": null,
      "entrypoint": null,
      "environment": {
        "GOMEMLIMIT": "200MiB",
        "RELIST_ACME_EMAIL": "",
        "RELIST_DATA_DIR": "/var/lib/relist-panel",
        "RELIST_DOMAIN": "panel.example.com",
        "RELIST_PORT": "8080",
        "TRAEFIK_HTTPS_PORT": "443",
        "TRAEFIK_HTTP_PORT": "80"
      },
      "image": "ghcr.io/relist/relist-panel@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
      "labels": {
        "traefik.enable": "true",
        "traefik.http.middlewares.panel-redirect.redirectscheme.permanent": "true",
        "traefik.http.middlewares.panel-redirect.redirectscheme.scheme": "https",
        "traefik.http.routers.panel-http.entrypoints": "web",
        "traefik.http.routers.panel-http.middlewares": "panel-redirect",
        "traefik.http.routers.panel-http.priority": "100000",
        "traefik.http.routers.panel-http.rule": "Host(`panel.example.com`)",
        "traefik.http.routers.panel-http.service": "panel",
        "traefik.http.routers.panel.entrypoints": "websecure",
        "traefik.http.routers.panel.priority": "100000",
        "traefik.http.routers.panel.rule": "Host(`panel.example.com`)",
        "traefik.http.routers.panel.service": "panel",
        "traefik.http.routers.panel.tls.certresolver": "letsencrypt",
        "traefik.http.services.panel.loadbalancer.server.port": "8080"
      },
      "mem_limit": "268435456",
      "networks": {
        "relist-network": null
      },
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 8080,
          "published": "8888",
          "protocol": "tcp"
        }
      ],
      "restart": "unless-stopped",
      "volumes": [
        {
          "type": "bind",
          "source": "/var/run/docker.sock",
          "target": "/var/run/docker.sock",
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/var/lib/relist-panel",
          "target": "/var/lib/relist-panel",
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/proc",
          "target": "/host/proc",
          "read_only": true,
          "bind": {}
        }
      ]
    },
    "traefik": {
      "cpus": 1,
      "command": [
        "--api.insecure=true"
      ],
      "entrypoint": null,
      "environment": {
        "GOMEMLIMIT": "400MiB"
      },
      "image": "traefik:v3.7",
      "mem_limit": "536870912",
      "networks": {
        "relist-network": null
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 80,
          "published": "80",
          "protocol": "tcp"
        },
        {
          "mode": "ingress",
          "target": 443,
          "published": "443",
          "protocol": "tcp"
        }
      ],
      "restart": "unless-stopped",
      "volumes": [
        {
          "type": "bind",
          "source": "/var/lib/relist-panel/.traefik",
          "target": "/letsencrypt",
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/var/lib/relist-panel/.traefik/dynamic",
          "target": "/letsencrypt/dynamic",
          "bind": {}
        },
        {
          "type": "bind",
          "source": "/var/run/docker.sock",
          "target": "/var/run/docker.sock",
          "read_only": true,
          "bind": {}
        }
      ]
    }
  }
}