[
  {"kind": "service-image", "service": "panel"},
  {"kind": "service-mount", "service": "panel", "source": "/var/run/docker.sock", "target": "/var/run/docker.sock"},
  {"kind": "data-dir-same-path", "service": "panel"},
  {"kind": "service-mount", "service": "panel", "source": "/proc", "target": "/host/proc", "read_only": true},
  {"kind": "service-network", "service": "panel", "network": "relist-network"},
  {"kind": "service-network", "service": "traefik", "network": "relist-network"},
  {"kind": "network-external", "network": "relist-network", "name": "relist-network"},
  {"kind": "service-command-has", "service": "traefik", "arg": "--configfile=/etc/traefik/traefik.yml"},
  {"kind": "service-mount", "service": "traefik", "source": "${RELIST_DATA_DIR:-/var/lib/relist-panel}/.traefik/static", "target": "/etc/traefik", "read_only": true},
  {"kind": "service-label", "service": "panel", "key": "traefik.http.routers.panel.entrypoints", "value": "websecure"},
  {"kind": "service-label", "service": "panel", "key": "traefik.http.routers.panel.tls.certresolver", "value": "letsencrypt"},
  {"kind": "service-label", "service": "panel", "key": "traefik.http.routers.panel.priority", "value": "100000"}
]
